# ========================================================
# ERP BCS Frontend — Environment Variables Template
# Salin berkas ini ke .env untuk konfigurasi lokal:
#   cp .env.example .env
# ========================================================

# Server-side only — URL Backend Laravel (Bisa langsung tembak ke server Biznet atau lokal)
API_URL=http://api.bcslabs.tech

# ========================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ========================================================
# Mode Lokal: arahkan ke host/port server atau localhost:
#   DATABASE_URL=postgresql://bcs_admin:password_db@localhost:5432/mybcs_db
# Mode Docker (Production): otomatis diatur via docker-compose.yml:
#   DATABASE_URL=postgresql://bcs_admin:password_db@database:5432/mybcs_db
DATABASE_URL=postgresql://bcs_admin:password_db@localhost:5432/mybcs_db

# ========================================================
# OPENCLAW AI CONFIGURATION
# ========================================================
OPENCLAW_BASE_URL=https://ai.bcslabs.tech/v1
OPENCLAW_API_KEY=your_openclaw_api_key_here
OPENCLAW_MODEL=glm-4.7-flash

# ========================================================
# PYTHON AI BRIDGE
# ========================================================
# Di Docker: http://ai-bridge:8000 | Di lokal: http://127.0.0.1:8000
AI_BRIDGE_URL=http://127.0.0.1:8000

# ========================================================
# THIRD-PARTY INTEGRATIONS
# ========================================================
EASYGO_TOKEN=your_easygo_token_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
